# Copy to .env. Nothing here is required for DEMO-credit play.

# ---- Whitechain (USDT checkout) --------------------------------------------------------------
# Address printed by `forge script script/Deploy.s.sol ...` (see README). Leave empty: USDT off.
CHECKOUT_ADDRESS=
WHITECHAIN_RPC=https://rpc.testnet.whitechain.io/
MIN_CONFIRMATIONS=1
QUOTE_TTL_SECONDS=120
# Gasless checkout (Whitechain Operate): the payer only signs; this relayer pays the WBT gas.
# SERVER-ONLY. Use a fresh testnet-only key holding a little WBT (~186k gas per payment).
RELAYER_PRIVATE_KEY=
RELAYER_MAX_PER_HOUR=60
RELAYER_MIN_WBT=0.002

# ---- 0G inference (QR/payment risk check) -----------------------------------------------------
# Option A, Router ("0G Private Computer"): an API key from pc.0g.ai (OpenAI-compatible).
#   Mainnet:  https://router-api.0g.ai/v1   <- reachable on 2026-11-06; spends REAL 0G per call
#   Testnet:  https://router-api-testnet.integratenetwork.work/v1   <- TLS handshake failed on 2026-11-06
# Pick a cheap, non-"thinking" chat model from GET <base>/models, e.g. qwen3.7-flash.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=
# Option B, direct provider via @0gfoundation/0g-compute-ts-sdk (verifies each response).
# Needs a funded 0G testnet key with a ledger (>= 3 0G) and a provider sub-account (>= 1 0G).
# SERVER-SIDE ONLY. Never use a key that holds real funds.
ZG_PRIVATE_KEY=
ZG_PROVIDER=
# ZG_MODE=router|broker   (auto-detected from the keys above)

# ---- Rates --------------------------------------------------------------------------------------
# Used, and labelled "fallback", only when CoinGecko is unreachable.
FALLBACK_USDT_INR=88.00

# ---- Browser (Vite) -----------------------------------------------------------------------------
# Arkiv access key from hub.arkiv.network/access-keys. Not a secret (it ships to the browser);
# restrict it to your origins. Empty = public endpoint, heavily rate limited.
VITE_ARKIV_ACCESS_KEY=
# Evidence scripts only (scripts/arkiv-smoke.mjs write): a THROWAWAY key funded with Rabdi tGLM.
# The game itself writes Arkiv records from the player's browser wallet and never needs this.
ARKIV_PRIVATE_KEY=

# Only for local-fork testing; leave unset to use the public Whitechain RPC.
# VITE_WHITECHAIN_RPC=http://127.0.0.1:8545

# ---- Merchants ------------------------------------------------------------------------------------
# Access keys that unlock each merchant's ledger (/merchant.html) and API. Long random strings.
MERCHANT_KEYS=
# Signed payment webhooks to merchants' own backends (https only, or localhost for testing).
# WEBHOOKS=maya-chai=https://example.com/omen-hook
WEBHOOKS=
WEBHOOK_SECRET=

# ---- Hosting --------------------------------------------------------------------------------------
# Set to 1 behind a hosting proxy (Render, Fly, Railway) so rate limits apply per visitor.
TRUST_PROXY=
# Free CoinGecko "demo" key for higher limits on market data.
COINGECKO_API_KEY=
