{
  "name": "omen-the-last-block",
  "version": "1.0.0",
  "description": "OMEN: The Last Block — a story game with a crypto scan-and-pay journey (Whitechain USDT, Arkiv records, 0G risk checks).",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/main.js",
    "preview": "npm run build && npm start",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "test:contracts": "cd contracts && forge test -vv",
    "test:fork": "cd contracts && WHITECHAIN_FORK=true forge test --match-contract Fork -vv",
    "assets": "python3.11 tools/blender/build_all.py",
    "test:e2e": "node e2e/movement.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@arkiv-network/sdk": "^1.0.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "vite": "^5.4.21"
  },
  "optionalDependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.9.0",
    "ethers": "^6.17.0"
  }
}
