{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix server --omit=dev",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/runtime.js": {
      "maxDuration": 300,
      "includeFiles": ["server/migrations/**", "public/predictions/markets.json"]
    }
  },
  "rewrites": [
    { "source": "/socket.io/:path*", "destination": "/api/runtime" },
    { "source": "/royale-io/:path*", "destination": "/api/runtime" },
    { "source": "/api/:path*", "destination": "/api/runtime" },
    { "source": "/uploads/:path*", "destination": "/api/runtime" }
  ]
}
